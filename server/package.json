{
  "name": "clipper-server",
  "version": "1.0.0",
  "description": "Local server for YT Short Clipper extension: yt-dlp + FFmpeg + AI viral-moment detection",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx --watch index.ts"
  },
  "author": "",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tmp": "^0.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/tmp": "^0.2.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
